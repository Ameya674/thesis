# ====================================================================
# THESIS DATA PROTECTION (Ignore all data files)
# ====================================================================
# Ignore all CSV, TSV, and ZIP files in the data directory and subdirectories
data/**/*.csv
data/**/*.tsv
data/**/*.zip

# Ignore specific large data directories entirely
data/nibrs/
data/crosswalk/
data/acled/
data/count_love/
data/ccc/

# Exception: Allow Jupyter Notebooks and Markdown inside data folders
!data/**/*.ipynb
!data/**/*.md

# ====================================================================
# PYTHON & JUPYTER DEBRIS
# ====================================================================
thesis_env/
.ipynb_checkpoints/
**/ .ipynb_checkpoints/
*-checkpoint.ipynb
__pycache__/
*.py[cod]

# OS files
.DS_Store
